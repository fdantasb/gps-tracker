# PlatformIO build output + downloaded library dependencies.
# Regenerated by `pio run`; never commit compiled binaries or
# vendored third-party library source.
.pio/
.pioenvs/
.piolibdeps/

# Compiled firmware images (produced under .pio, but ignore anywhere)
*.bin
*.elf
*.hex

# Editors / IDEs
.vscode/
.idea/
*.code-workspace

# Python cruft (scripts/)
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store
